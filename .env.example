# Mongo read-only (DB pulppo) — NUNCA subir el valor real al repo
MONGO_URI=

# Login con Google (mismo esquema que customer-cx / pulppo-tools)
NEXT_PUBLIC_API_URL=            # backend Pulppo que canjea el code por el firebase_token
NEXT_PUBLIC_GOOGLE_CLIENT_ID=   # OAuth client id de Google
NEXT_PUBLIC_FIREBASE=           # JSON de config de Firebase (una línea)

# Allowlist de acceso (coma-separado). Si está vacío usa el fallback de src/lib/access.ts
ALLOWED_EMAILS=

# SendGrid — envío de campañas de email (módulo /campanas)
SENDGRID_API_KEY=               # API key de SendGrid (Mail Send). NUNCA subir el valor real
SENDGRID_FROM_EMAIL=            # remitente verificado en el dominio autenticado (ej. exclusivas@pulppo.com)
SENDGRID_FROM_NAME=             # nombre visible del remitente (default: Pulppo)
SENDGRID_SANDBOX=               # 1 = modo sandbox (valida sin enviar de verdad); vacío = envía
